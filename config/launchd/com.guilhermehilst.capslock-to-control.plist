<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Caps Lock (HID 0x700000039) → Right Control (HID 0x7000000E4) on every
  keyboard, including ones connected later. hidutil mappings don't survive
  reboots, so this runs at each login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.guilhermehilst.capslock-to-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E4}]}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
