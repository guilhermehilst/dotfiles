#!/usr/bin/env bash
#
# Install Homebrew and Packages
#
# Exits the script immediately if a command exits with a non-zero status (indicating an error).
set -e

info "============================================="
info "            Installing Homebrew"
info "                and Packages"
info "============================================="

# Install Homebrew if not present
if ! command -v brew >/dev/null 2>&1; then
  step_green "Homebrew não encontrado, instalando..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  success "✔ Homebrew instalado com sucesso"
else
  success "✔ Homebrew já instalado"
fi

# Load brew into the current shell session (Apple Silicon or Intel)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Install packages from the Brewfile
step_green "Instalando pacotes do Brewfile"
brew bundle --file="$CONFIG_PATH/homebrew/Brewfile"
success "✔ Pacotes do Brewfile instalados"
